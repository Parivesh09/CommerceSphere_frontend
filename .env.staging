# Staging Environment Configuration

# API Configuration
VITE_API_GATEWAY_URL=https://api-staging.commercesphere.com
VITE_WS_URL=wss://api-staging.commercesphere.com

# App Configuration
VITE_APP_NAME=CommerceSphere
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=staging

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_SERVICE_WORKER=true

# External Services
VITE_STRIPE_PUBLIC_KEY=pk_test_staging_key_here

# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=UA-STAGING-ID

# Sentry Error Tracking
VITE_SENTRY_DSN=https://your-sentry-dsn-staging@sentry.io/project-id

# Performance
VITE_CACHE_DURATION=300000

# Debug
VITE_DEBUG_MODE=false
